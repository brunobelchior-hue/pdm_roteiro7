<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configurações"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#111111" />

    <Switch
        android:id="@+id/sw_notificacoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Receber notificações"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txt_recebido_activity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Aguardando configuração da Activity"
        android:textColor="#555555" />

    <Button
        android:id="@+id/btn_salvar_config"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Salvar configurações" />

</LinearLayout>
