<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Segurança"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#111111" />

    <Switch
        android:id="@+id/sw_biometria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Usar biometria"
        android:textSize="18sp" />

    <Switch
        android:id="@+id/sw_bloqueio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Bloqueio automático"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/txt_nivel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Nível recebido da Activity: aguardando"
        android:textColor="#555555" />

</LinearLayout>
